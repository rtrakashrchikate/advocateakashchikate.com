{
  "extraKnownMarketplaces": {
    "agricidaniel-claude-seo": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-seo"
      }
    },
    "ai-marketing-hub-claude-ads": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-ads"
      }
    }
  },
  "enabledPlugins": {
    "claude-seo@agricidaniel-claude-seo": true,
    "seo-cockpit@agricidaniel-claude-seo": true,
    "claude-ads@ai-marketing-hub-claude-ads": true
  },
  "pluginConfigs": {
    "seo-cockpit@agricidaniel-claude-seo": {
      "options": {
        "site": "https://advocateakashchikate.com",
        "pageUrl": "https://advocateakashchikate.com/"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
